<script>
(function(){
  var images = [
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,"
  ];
  var inner = document.getElementById('refineFlip');
  var front = document.getElementById('flipImgFront');
  var back = document.getElementById('flipImgBack');
  var dots = document.querySelectorAll('#refineFlipDots span');
  var idx = 0;
  var showingFront = true;

  function setDots(activeIdx) {
    dots.forEach(function(d, i) { d.classList.toggle('active', i === activeIdx); });
  }

  function flip() {
    var upcoming = (idx + 1) % images.length;
    if (showingFront) {
      back.src = images[upcoming];
    } else {
      front.src = images[upcoming];
    }
    inner.classList.toggle('is-flipped');
    showingFront = !showingFront;
    idx = upcoming;
    setDots(idx);
  }

  setInterval(flip, 3000);
})();
</script>

